<settings>
    <!-- Red Hat Lightwell Network - Maven Settings Configuration -->
    <servers>
        <server>
            <id>redhat-lightwell-remediated</id>
            <username>${env.LIGHTWELL_SERVICE_ACCOUNT_ID}</username>
            <password>${env.LIGHTWELL_REGISTRY_TOKEN}</password>
        </server>
        <server>
            <id>redhat-lightwell-validated</id>
            <username>${env.LIGHTWELL_SERVICE_ACCOUNT_ID}</username>
            <password>${env.LIGHTWELL_REGISTRY_TOKEN}</password>
        </server>
        <server>
            <id>redhat-lightwell-predisclosure</id>
            <username>${env.LIGHTWELL_SERVICE_ACCOUNT_ID}</username>
            <password>${env.LIGHTWELL_REGISTRY_TOKEN}</password>
        </server>
    </servers>

    <profiles>
        <profile>
            <id>lightwell-repositories</id>
            <repositories>
                <!-- Remediated Repository: Surgical drop-in patches for pinned versions (x.y.z.rhlw-####) -->
                <repository>
                    <id>redhat-lightwell-remediated</id>
                    <name>Red Hat Lightwell Remediated Repository</name>
                    <url>https://packages.example.com/lightwell/maven/remediated/</url>
                    <releases>
                        <enabled>true</enabled>
                        <updatePolicy>always</updatePolicy>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>

                <!-- Validated Repository: Verified zero-CVE upstream packages -->
                <repository>
                    <id>redhat-lightwell-validated</id>
                    <name>Red Hat Lightwell Validated Repository</name>
                    <url>https://packages.example.com/lightwell/maven/validated/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>

                <!-- Predisclosure Repository: Embargoed novel zero-day fixes (-nxxxx) -->
                <repository>
                    <id>redhat-lightwell-predisclosure</id>
                    <name>Red Hat Lightwell Predisclosure Repository</name>
                    <url>https://packages.example.com/lightwell/maven/predisclosure/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>lightwell-repositories</activeProfile>
    </activeProfiles>
</settings>
