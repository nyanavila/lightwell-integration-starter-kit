{
  "key": "redhat-lightwell-maven-remote",
  "packageType": "maven",
  "description": "Remote proxy cache for Red Hat Lightwell Maven Remediated repository",
  "url": "https://packages.example.com/lightwell/maven/remediated/",
  "username": "${LIGHTWELL_SERVICE_ACCOUNT_ID}",
  "password": "${LIGHTWELL_REGISTRY_TOKEN}",
  "handleReleases": true,
  "handleSnapshots": false,
  "maxUniqueSnapshots": 0,
  "suppressPomConsistencyChecks": false,
  "fetchJarsEagerly": false,
  "fetchSourcesEagerly": true,
  "shareConfiguration": false,
  "blockMismatchingMimeTypes": true,
  "propertySets": [
    "artifactory"
  ],
  "retrievalCachePeriodSecs": 43200,
  "missedRetrievalCachePeriodSecs": 1800
}
