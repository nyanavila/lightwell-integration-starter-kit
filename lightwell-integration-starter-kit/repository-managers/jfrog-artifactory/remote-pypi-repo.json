{
  "key": "redhat-lightwell-pypi-remote",
  "packageType": "pypi",
  "description": "Remote proxy cache for Red Hat Lightwell PyPI Remediated repository",
  "url": "https://packages.example.com/api/pypi/lightwell/remediated/simple/",
