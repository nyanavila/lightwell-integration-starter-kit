{
  "name": "redhat-lightwell-pypi-proxy",
  "format": "pypi",
  "type": "proxy",
  "url": "https://packages.example.com/api/pypi/lightwell/remediated/simple/",
  "online": true,
  "storage": {
    "blobStoreName": "default",
    "strictContentTypeValidation": true
  },
  "httpClient": {
    "blocked": false,
    "autoBlock": true,
    "connection": {
      "retries": 2,
      "timeout": 30
    },
    "authentication": {
      "type": "username",
      "username": "${LIGHTWELL_SERVICE_ACCOUNT_ID}",
      "password": "${LIGHTWELL_REGISTRY_TOKEN}"
    }
  }
}
